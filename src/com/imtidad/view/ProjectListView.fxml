<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="720" prefWidth="1180" minHeight="620" minWidth="900"
            nodeOrientation="LEFT_TO_RIGHT"
            stylesheets="@../../../style.css"
            styleClass="root,home-dashboard-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imtidad.controller.ProjectController">

    <right>
        <VBox prefWidth="230" minWidth="210" spacing="10" nodeOrientation="RIGHT_TO_LEFT" styleClass="imt-sidebar">
            <padding><Insets top="24" right="18" bottom="20" left="18"/></padding>
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="sidebar-brand-row">
                    <children>
                        <ImageView fitHeight="38" fitWidth="38" preserveRatio="true">
                            <image><Image url="@../../../images/IMTIDAD_logo.png"/></image>
                        </ImageView>
                        <VBox spacing="1">
                            <children>
                                <Label text="امتداد" styleClass="sidebar-brand"/>
                                <Label text="IMTIDAD" styleClass="sidebar-brand-en"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label text="جامعة العلوم والتكنولوجيا" wrapText="true" styleClass="sidebar-university"/>
                <Separator styleClass="sidebar-separator"/>

                <Button text="⌂  الصفحة الرئيسية" onAction="#showHome" maxWidth="Infinity"
                        styleClass="sidebar-button,sidebar-button-active"/>
                <Button fx:id="btnAddProject" text="＋  إضافة مشروع" onAction="#openAddProjectWindow"
                        maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="▦  مشاريعي" onAction="#showMyProjects" maxWidth="Infinity"
                        styleClass="sidebar-button"/>
                <Button text="↗  طلبات الاستكمال" onAction="#openContinuationRequests" maxWidth="Infinity"
                        styleClass="sidebar-button"/>
                <Button fx:id="btnReviewQueue" text="✓  طلبات المراجعة" onAction="#openReviewQueue"
                        maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="☆  المفضلة" disable="true" maxWidth="Infinity"
                        styleClass="sidebar-button,sidebar-disabled"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator styleClass="sidebar-separator"/>
                <Button text="ⓘ  عن امتداد" onAction="#openAbout" maxWidth="Infinity"
                        styleClass="sidebar-button"/>
                <Button text="⚙  الإعدادات" onAction="#showSettingsNotice" maxWidth="Infinity"
                        styleClass="sidebar-button"/>
                <Button text="↪  تسجيل الخروج" onAction="#logout" maxWidth="Infinity"
                        styleClass="sidebar-button,sidebar-logout"/>
            </children>
        </VBox>
    </right>

    <center>
        <VBox spacing="18" nodeOrientation="RIGHT_TO_LEFT" styleClass="home-dashboard-content">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
            <children>
                <BorderPane nodeOrientation="LEFT_TO_RIGHT" styleClass="home-app-header">
                    <right>
                        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="home-header-brand">
                            <children>
                                <ImageView fitHeight="34" fitWidth="34" preserveRatio="true">
                                    <image><Image url="@../../../images/IMTIDAD_logo.png"/></image>
                                </ImageView>
                                <VBox alignment="CENTER_RIGHT" spacing="1">
                                    <children>
                                        <Label text="IMTIDAD | امتداد" styleClass="home-header-brand-title"/>
                                        <Label text="جامعة العلوم والتكنولوجيا" styleClass="home-header-university"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </right>
                    <left>
                        <HBox alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" spacing="10" styleClass="home-header-user-area">
                            <children>
                                <Button fx:id="btnThemeToggle" text="☀" onAction="#toggleTheme" focusTraversable="false" styleClass="theme-toggle-button">
                                    <tooltip><Tooltip text="تبديل المظهر"/></tooltip>
                                </Button>
                                <Button focusTraversable="false" mouseTransparent="true" styleClass="home-header-icon-button">
                                    <graphic>
                                        <SVGPath content="M12 22c1.1 0 1.99-.9 1.99-2h-4c0 1.1.9 2 2.01 2zM18 16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" scaleX="0.72" scaleY="0.72" styleClass="home-bell-icon"/>
                                    </graphic>
                                    <tooltip><Tooltip text="الإشعارات غير مفعلة حالياً"/></tooltip>
                                </Button>
                                <StackPane minHeight="36" minWidth="36" prefHeight="36" prefWidth="36" styleClass="home-account-avatar">
                                    <children>
                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" scaleX="0.72" scaleY="0.72" styleClass="home-account-icon"/>
                                    </children>
                                </StackPane>
                                <VBox alignment="CENTER_RIGHT" nodeOrientation="RIGHT_TO_LEFT" spacing="2">
                                    <children>
                                        <Label fx:id="lblGreeting" text="مرحباً" styleClass="home-greeting"/>
                                        <Label fx:id="lblRole" text="" styleClass="home-role"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </left>
                </BorderPane>

                <HBox alignment="TOP_RIGHT" spacing="16" styleClass="home-hero-card">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="لوحة الامتداد الأكاديمية" styleClass="section-kicker"/>
                                <Label fx:id="lblDashboardTitle" text="استكشف مشاريع الجامعة" styleClass="home-hero-title"/>
                                <Label fx:id="lblDashboardSubtitle" text="اكتشف مشاريع التخرج ومشاريع المقررات، وتابع الامتدادات والمراجعات ضمن تجربة موحّدة وراقية." wrapText="true" styleClass="home-hero-subtitle"/>
                                <HBox spacing="8" styleClass="home-chip-row">
                                    <children>
                                        <Label text="مشاريع قابلة للاستكشاف" styleClass="hero-chip"/>
                                        <Label text="مراجعات منظمة" styleClass="hero-chip"/>
                                        <Label text="شجرة الامتداد" styleClass="hero-chip"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="12" minWidth="240" prefWidth="250">
                            <children>
                                <HBox spacing="8">
                                    <children>
                                        <Button text="↻ تحديث" onAction="#refreshProjects" styleClass="btn-outline" HBox.hgrow="ALWAYS"/>
                                        <Button text="فتح التفاصيل ←" onAction="#openProjectPassport" styleClass="btn-primary" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <FlowPane hgap="12" vgap="12" prefWrapLength="850" styleClass="home-metrics-row">
                    <children>
                        <VBox styleClass="home-metric-card">
                            <children>
                                <Label fx:id="lblMetricOneTitle" text="إجمالي المشاريع" styleClass="home-metric-label"/>
                                <Label fx:id="lblMetricOneValue" text="0" styleClass="home-metric-value"/>
                            </children>
                        </VBox>
                        <VBox styleClass="home-metric-card">
                            <children>
                                <Label fx:id="lblMetricTwoTitle" text="المسودات" styleClass="home-metric-label"/>
                                <Label fx:id="lblMetricTwoValue" text="0" styleClass="home-metric-value"/>
                            </children>
                        </VBox>
                        <VBox styleClass="home-metric-card">
                            <children>
                                <Label fx:id="lblMetricThreeTitle" text="قيد المراجعة" styleClass="home-metric-label"/>
                                <Label fx:id="lblMetricThreeValue" text="0" styleClass="home-metric-value"/>
                            </children>
                        </VBox>
                        <VBox styleClass="home-metric-card">
                            <children>
                                <Label fx:id="lblMetricFourTitle" text="مشاريع لها امتدادات" styleClass="home-metric-label"/>
                                <Label fx:id="lblMetricFourValue" text="0" styleClass="home-metric-value"/>
                            </children>
                        </VBox>
                    </children>
                </FlowPane>

                <VBox spacing="12" styleClass="section-shell">
                    <children>
                        <HBox spacing="10" styleClass="home-dashboard-toolbar">
                            <children>
                                <TextField fx:id="txtSearch" promptText="ابحث باسم المشروع أو وصفه" HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="cmbStatusFilter" promptText="كل الحالات" prefWidth="180"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblDashboardState" text="جاري تحميل المشاريع..." styleClass="text-muted"/>

                        <StackPane VBox.vgrow="ALWAYS">
                            <children>
                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="dashboard-scroll">
                                    <content>
                                        <FlowPane fx:id="projectCards" hgap="14" vgap="14" prefWrapLength="850" styleClass="home-project-card-grid"/>
                                    </content>
                                </ScrollPane>

                                <VBox fx:id="emptyProjects" alignment="CENTER" maxWidth="390" spacing="8" styleClass="home-empty-state" visible="false" managed="false">
                                    <children>
                                        <Label text="لا توجد مشاريع لعرضها" styleClass="title-md"/>
                                        <Label text="ستظهر هنا المشاريع المتاحة عند توفرها." textAlignment="CENTER" wrapText="true" styleClass="text-muted"/>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
